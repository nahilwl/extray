{
  "name": "Vulnerable Manifest Fixture",
  "version": "1.0",
  "manifest_version": 2,
  "permissions": [
    "cookies",
    "<all_urls>"
  ],
  "externally_connectable": {
    "ids": ["*"],
    "matches": ["*://*/*"]
  },
  "web_accessible_resources": ["options.html"],
  "content_security_policy": "script-src 'self' 'unsafe-eval' https://cdn.example.com; object-src 'self'",
  "content_scripts": [
    {"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}
  ]
}
